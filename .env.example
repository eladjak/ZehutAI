# ZehutAI Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# OpenAI API Key (required for RAG pipeline features that use OpenAI)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# HuggingFace Token (optional, for accessing gated models)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Device configuration (optional, auto-detected if not set)
# Options: cuda, cpu
# DEVICE=cuda

# Transformers cache directory (optional)
# TRANSFORMERS_CACHE=./models
